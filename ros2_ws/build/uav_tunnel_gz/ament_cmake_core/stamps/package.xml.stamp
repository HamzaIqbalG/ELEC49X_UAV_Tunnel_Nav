<?xml version="1.0"?>
<package format="3">
  <name>uav_tunnel_gz</name>
  <version>0.1.0</version>
  <description>Gazebo Fortress assets and cmd_vel system plugin for the UAV tunnel demo.</description>
  <maintainer email="dev@example.com">UAV Tunnel</maintainer>
  <license>Apache-2.0</license>

  <buildtool_depend>ament_cmake</buildtool_depend>

  <depend>gz-sim7</depend>
  <depend>gz-transport12</depend>
  <depend>gz-msgs9</depend>

  <export>
    <build_type>ament_cmake</build_type>
  </export>
</package>
