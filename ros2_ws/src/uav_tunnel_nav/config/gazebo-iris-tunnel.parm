DDS_ENABLE 0

# Iris X-frame for tunnel navigation (no gimbal)
FRAME_CLASS 1
FRAME_TYPE 1

# Match servo PWM range to ArduPilotPlugin config
MOT_PWM_MIN 1100
MOT_PWM_MAX 1900

# Speed limits (conservative for indoor tunnel)
PILOT_SPEED_DN 100
PILOT_SPEED_UP 150
WPNAV_SPEED 200
WPNAV_SPEED_DN 100
WPNAV_SPEED_UP 150
ANGLE_MAX 2000

# Phase 1: use SITL simulated GPS so EKF has full state feedback.
# Will be replaced with ExternalNav (SLAM) sources in Phase 2.
ARMING_CHECK 0
