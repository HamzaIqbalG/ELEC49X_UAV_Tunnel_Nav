DDS_ENABLE 0

# Iris X-frame for tunnel navigation (no gimbal)
FRAME_CLASS 1
FRAME_TYPE 1

# Match servo PWM range to ArduPilotPlugin config
MOT_PWM_MIN 1100
MOT_PWM_MAX 1900

# Speed limits (conservative for indoor tunnel)
PILOT_SPEED_DN 100
PILOT_SPEED_UP 150
WPNAV_SPEED 200
WPNAV_SPEED_DN 100
WPNAV_SPEED_UP 150
ANGLE_MAX 2000

# Phase 2: GPS-denied navigation using SLAM external nav.
# Disable GPS so EKF3 does not wait for a GPS fix.
GPS_TYPE 0

# EKF3 configuration — use ExternalNav (source 6) for horizontal position
# and yaw; keep barometer (source 1) for vertical to avoid SLAM Z drift.
AHRS_EKF_TYPE 3
EK3_ENABLE 1
EK3_SRC1_POSXY 6
EK3_SRC1_VELXY 6
EK3_SRC1_POSZ 1
EK3_SRC1_VELZ 0
EK3_SRC1_YAW 6

# Enable vision position input processing in ArduPilot.
VISO_TYPE 1

# Disable all arming checks so the vehicle can arm without GPS.
ARMING_CHECK 0
