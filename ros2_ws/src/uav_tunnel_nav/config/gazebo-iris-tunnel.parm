# Iris X-frame for tunnel navigation (no gimbal)
FRAME_CLASS 1
FRAME_TYPE 1

# Match servo PWM range to ArduPilotPlugin config
MOT_PWM_MIN 1100
MOT_PWM_MAX 1900

# Speed limits (conservative for indoor tunnel)
PILOT_SPEED_DN 100
PILOT_SPEED_UP 150
WPNAV_SPEED 200
WPNAV_SPEED_DN 100
WPNAV_SPEED_UP 150
ANGLE_MAX 2000

# Disable GPS requirement (tunnel has no GPS)
ARMING_CHECK 0
GPS_TYPE 0
EK3_SRC1_POSXY 0
EK3_SRC1_VELXY 0
EK3_SRC1_POSZ 1
EK3_SRC1_VELZ 0
EK3_SRC1_YAW 1
