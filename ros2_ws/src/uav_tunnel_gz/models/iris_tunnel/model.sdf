<?xml version="1.0"?>
<sdf version="1.9">
  <model name="iris_tunnel">
    <pose>0 0 0.2 0 0 0</pose>

    <!-- ═══════════════════════════════════════════════════════════════ -->
    <!--  Body                                                          -->
    <!-- ═══════════════════════════════════════════════════════════════ -->
    <link name="base_link">
      <inertial>
        <mass>1.5</mass>
        <inertia>
          <ixx>0.008</ixx>
          <iyy>0.015</iyy>
          <izz>0.017</izz>
        </inertia>
      </inertial>
      <collision name="body_collision">
        <geometry><box><size>0.47 0.47 0.23</size></box></geometry>
      </collision>
      <visual name="body_visual">
        <geometry><box><size>0.30 0.30 0.08</size></box></geometry>
        <material>
          <ambient>0.1 0.2 0.8 1</ambient>
          <diffuse>0.1 0.2 0.8 1</diffuse>
        </material>
      </visual>
      <visual name="arm_x">
        <pose>0 0 0.01 0 0 0.785</pose>
        <geometry><box><size>0.55 0.04 0.02</size></box></geometry>
        <material>
          <ambient>0.1 0.1 0.1 1</ambient>
          <diffuse>0.1 0.1 0.1 1</diffuse>
        </material>
      </visual>
      <visual name="arm_y">
        <pose>0 0 0.01 0 0 -0.785</pose>
        <geometry><box><size>0.55 0.04 0.02</size></box></geometry>
        <material>
          <ambient>0.1 0.1 0.1 1</ambient>
          <diffuse>0.1 0.1 0.1 1</diffuse>
        </material>
      </visual>
    </link>

    <!-- ═══════════════════════════════════════════════════════════════ -->
    <!--  IMU link + sensor                                             -->
    <!-- ═══════════════════════════════════════════════════════════════ -->
    <link name="imu_link">
      <pose relative_to="base_link">0 0 0 0 0 0</pose>
      <inertial>
        <mass>0.15</mass>
        <inertia>
          <ixx>0.00001</ixx>
          <iyy>0.00002</iyy>
          <izz>0.00002</izz>
        </inertia>
      </inertial>
      <sensor name="imu_sensor" type="imu">
        <pose>0 0 0 3.14159 0 0</pose>
        <always_on>1</always_on>
        <update_rate>1000</update_rate>
      </sensor>
    </link>
    <joint name="imu_joint" type="fixed">
      <parent>base_link</parent>
      <child>imu_link</child>
    </joint>

    <!-- ═══════════════════════════════════════════════════════════════ -->
    <!--  Rotors (iris X-frame layout)                                  -->
    <!-- ═══════════════════════════════════════════════════════════════ -->

    <!-- Rotor 0 – front-right (CW) -->
    <link name="rotor_0">
      <pose relative_to="base_link">0.13 -0.22 0.023 0 0 0</pose>
      <inertial>
        <mass>0.025</mass>
        <inertia>
          <ixx>9.75e-06</ixx>
          <iyy>0.000166704</iyy>
          <izz>0.000167604</izz>
        </inertia>
      </inertial>
      <visual name="vis">
        <geometry><cylinder><radius>0.1</radius><length>0.01</length></cylinder></geometry>
        <material>
          <ambient>0.2 0.2 0.2 0.8</ambient>
          <diffuse>0.2 0.2 0.2 0.8</diffuse>
        </material>
      </visual>
    </link>
    <joint name="rotor_0_joint" type="revolute">
      <parent>base_link</parent>
      <child>rotor_0</child>
      <axis>
        <xyz>0 0 1</xyz>
        <limit><lower>-1e+16</lower><upper>1e+16</upper></limit>
        <dynamics><damping>0.004</damping></dynamics>
      </axis>
    </joint>

    <!-- Rotor 1 – rear-left (CW) -->
    <link name="rotor_1">
      <pose relative_to="base_link">-0.13 0.2 0.023 0 0 0</pose>
      <inertial>
        <mass>0.025</mass>
        <inertia>
          <ixx>9.75e-06</ixx>
          <iyy>0.000166704</iyy>
          <izz>0.000167604</izz>
        </inertia>
      </inertial>
      <visual name="vis">
        <geometry><cylinder><radius>0.1</radius><length>0.01</length></cylinder></geometry>
        <material>
          <ambient>0.2 0.2 0.2 0.8</ambient>
          <diffuse>0.2 0.2 0.2 0.8</diffuse>
        </material>
      </visual>
    </link>
    <joint name="rotor_1_joint" type="revolute">
      <parent>base_link</parent>
      <child>rotor_1</child>
      <axis>
        <xyz>0 0 1</xyz>
        <limit><lower>-1e+16</lower><upper>1e+16</upper></limit>
        <dynamics><damping>0.004</damping></dynamics>
      </axis>
    </joint>

    <!-- Rotor 2 – front-left (CCW) -->
    <link name="rotor_2">
      <pose relative_to="base_link">0.13 0.22 0.023 0 0 0</pose>
      <inertial>
        <mass>0.025</mass>
        <inertia>
          <ixx>9.75e-06</ixx>
          <iyy>0.000166704</iyy>
          <izz>0.000167604</izz>
        </inertia>
      </inertial>
      <visual name="vis">
        <geometry><cylinder><radius>0.1</radius><length>0.01</length></cylinder></geometry>
        <material>
          <ambient>0.6 0.6 0.6 0.8</ambient>
          <diffuse>0.6 0.6 0.6 0.8</diffuse>
        </material>
      </visual>
    </link>
    <joint name="rotor_2_joint" type="revolute">
      <parent>base_link</parent>
      <child>rotor_2</child>
      <axis>
        <xyz>0 0 1</xyz>
        <limit><lower>-1e+16</lower><upper>1e+16</upper></limit>
        <dynamics><damping>0.004</damping></dynamics>
      </axis>
    </joint>

    <!-- Rotor 3 – rear-right (CCW) -->
    <link name="rotor_3">
      <pose relative_to="base_link">-0.13 -0.2 0.023 0 0 0</pose>
      <inertial>
        <mass>0.025</mass>
        <inertia>
          <ixx>9.75e-06</ixx>
          <iyy>0.000166704</iyy>
          <izz>0.000167604</izz>
        </inertia>
      </inertial>
      <visual name="vis">
        <geometry><cylinder><radius>0.1</radius><length>0.01</length></cylinder></geometry>
        <material>
          <ambient>0.6 0.6 0.6 0.8</ambient>
          <diffuse>0.6 0.6 0.6 0.8</diffuse>
        </material>
      </visual>
    </link>
    <joint name="rotor_3_joint" type="revolute">
      <parent>base_link</parent>
      <child>rotor_3</child>
      <axis>
        <xyz>0 0 1</xyz>
        <limit><lower>-1e+16</lower><upper>1e+16</upper></limit>
        <dynamics><damping>0.004</damping></dynamics>
      </axis>
    </joint>

    <!-- ═══════════════════════════════════════════════════════════════ -->
    <!--  LiDAR (360-degree planar, for SLAM + navigation)             -->
    <!-- ═══════════════════════════════════════════════════════════════ -->
    <link name="lidar_link">
      <pose relative_to="base_link">0 0 -0.05 0 0 0</pose>
      <inertial>
        <mass>0.005</mass>
        <inertia>
          <ixx>8.33e-06</ixx>
          <iyy>8.33e-06</iyy>
          <izz>8.33e-06</izz>
        </inertia>
      </inertial>
      <visual name="vis">
        <geometry><cylinder><radius>0.03</radius><length>0.03</length></cylinder></geometry>
        <material>
          <ambient>0.8 0.2 0.2 1</ambient>
          <diffuse>0.8 0.2 0.2 1</diffuse>
        </material>
      </visual>
      <sensor name="lidar" type="gpu_lidar">
        <always_on>1</always_on>
        <update_rate>10</update_rate>
        <topic>/lidar</topic>
        <lidar>
          <scan>
            <horizontal>
              <samples>720</samples>
              <resolution>1</resolution>
              <min_angle>-3.14159</min_angle>
              <max_angle>3.14159</max_angle>
            </horizontal>
          </scan>
          <range>
            <min>0.08</min>
            <max>30.0</max>
            <resolution>0.01</resolution>
          </range>
          <noise>
            <type>gaussian</type>
            <mean>0</mean>
            <stddev>0.01</stddev>
          </noise>
        </lidar>
      </sensor>
    </link>
    <joint name="lidar_joint" type="fixed">
      <parent>base_link</parent>
      <child>lidar_link</child>
    </joint>

    <!-- ═══════════════════════════════════════════════════════════════ -->
    <!--  ArduPilot SITL Plugin                                         -->
    <!-- ═══════════════════════════════════════════════════════════════ -->
    <plugin name="ArduPilotPlugin" filename="ArduPilotPlugin">
      <fdm_addr>127.0.0.1</fdm_addr>
      <fdm_port_in>9002</fdm_port_in>
      <connectionTimeoutMaxCount>5</connectionTimeoutMaxCount>
      <lock_step>1</lock_step>

      <modelXYZToAirplaneXYZ>0 0 0 3.14159 0 0</modelXYZToAirplaneXYZ>
      <gazeboXYZToNED>0 0 0 3.14159 0 1.5708</gazeboXYZToNED>

      <imuName>imu_link::imu_sensor</imuName>

      <!-- Motor 1: front-right CW -->
      <control channel="0">
        <jointName>rotor_0_joint</jointName>
        <multiplier>838</multiplier>
        <offset>0</offset>
        <servo_min>1100</servo_min>
        <servo_max>1900</servo_max>
        <type>VELOCITY</type>
        <p_gain>0.20</p_gain>
        <i_gain>0</i_gain>
        <d_gain>0</d_gain>
        <i_max>0</i_max>
        <i_min>0</i_min>
        <cmd_max>2.5</cmd_max>
        <cmd_min>-2.5</cmd_min>
        <controlVelocitySlowdownSim>1</controlVelocitySlowdownSim>
      </control>

      <!-- Motor 2: rear-left CW -->
      <control channel="1">
        <jointName>rotor_1_joint</jointName>
        <multiplier>838</multiplier>
        <offset>0</offset>
        <servo_min>1100</servo_min>
        <servo_max>1900</servo_max>
        <type>VELOCITY</type>
        <p_gain>0.20</p_gain>
        <i_gain>0</i_gain>
        <d_gain>0</d_gain>
        <i_max>0</i_max>
        <i_min>0</i_min>
        <cmd_max>2.5</cmd_max>
        <cmd_min>-2.5</cmd_min>
        <controlVelocitySlowdownSim>1</controlVelocitySlowdownSim>
      </control>

      <!-- Motor 3: front-left CCW -->
      <control channel="2">
        <jointName>rotor_2_joint</jointName>
        <multiplier>-838</multiplier>
        <offset>0</offset>
        <servo_min>1100</servo_min>
        <servo_max>1900</servo_max>
        <type>VELOCITY</type>
        <p_gain>0.20</p_gain>
        <i_gain>0</i_gain>
        <d_gain>0</d_gain>
        <i_max>0</i_max>
        <i_min>0</i_min>
        <cmd_max>2.5</cmd_max>
        <cmd_min>-2.5</cmd_min>
        <controlVelocitySlowdownSim>1</controlVelocitySlowdownSim>
      </control>

      <!-- Motor 4: rear-right CCW -->
      <control channel="3">
        <jointName>rotor_3_joint</jointName>
        <multiplier>-838</multiplier>
        <offset>0</offset>
        <servo_min>1100</servo_min>
        <servo_max>1900</servo_max>
        <type>VELOCITY</type>
        <p_gain>0.20</p_gain>
        <i_gain>0</i_gain>
        <d_gain>0</d_gain>
        <i_max>0</i_max>
        <i_min>0</i_min>
        <cmd_max>2.5</cmd_max>
        <cmd_min>-2.5</cmd_min>
        <controlVelocitySlowdownSim>1</controlVelocitySlowdownSim>
      </control>
    </plugin>

  </model>
</sdf>
